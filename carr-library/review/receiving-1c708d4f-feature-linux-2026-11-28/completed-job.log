2026-11-28T10:10:09.8273598Z     def test_actual_worker_cancel_reaps_child_before_lease_and_stage_release(bound, tmp_path, monkeypatch):
2026-11-28T10:10:09.8273688Z         marker = tmp_path / 'worker-ready.json'
2026-11-28T10:10:09.8273846Z         actual_command, actual_start = layout_module._command, process._start_process
2026-11-28T10:10:09.8273919Z         commands, children = [], []
2026-11-28T10:10:09.8274000Z         def blocked(*args, **kwargs):
2026-11-28T10:10:09.8274111Z             command, environment = actual_command(*args, **kwargs)
2026-11-28T10:10:09.8274198Z             index = command.index('-c') + 1
2026-11-28T10:10:09.8274274Z             command[index] = (
2026-11-28T10:10:09.8274443Z                 'import os,time; from pathlib import Path; p=Path(' + repr(str(marker)) + '); '
2026-11-28T10:10:09.8274595Z                 't=p.with_suffix(".pending"); t.write_bytes(b"owned"); os.replace(t,p); '
2026-11-28T10:10:09.8274680Z                 'time.sleep(60); ' + command[index])
2026-11-28T10:10:09.8274769Z             commands.append(tuple(command))
