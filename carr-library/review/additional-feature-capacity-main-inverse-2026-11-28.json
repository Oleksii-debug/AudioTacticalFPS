        "        if: ${{ success() && steps.complete_bundle.outcome == 'success' }}"
      ],
      "added": [
        "        if: ${{ success() && steps.complete_bundle.outcome == 'success' && steps.additional_bundle.outcome == 'success' && steps.additional_source.outcome == 'success' }}"
