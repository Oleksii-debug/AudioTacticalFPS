        "        timeout-minutes: 30",
        "        run: |",
        "          $sourceCommit = (git rev-parse HEAD).Trim()",
        "          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
        "          Remove-Item Env:PYTHONPATH, Env:PYTEST_ADDOPTS, Env:PYTEST_PLUGINS -ErrorAction SilentlyContinue",
        "          $env:PYTEST_DISABLE_PLUGIN_AUTOLOAD = '1'",
        "          $env:PATH = \"$env:CARR_CI_OCR_DIR;$env:PATH\"",
        "          $env:TESSDATA_PREFIX = Join-Path $env:CARR_CI_OCR_DIR 'tessdata'",
        "          $env:CARR_OCR_DIR = $env:CARR_CI_OCR_DIR",
        "          $env:CARR_TEST_MODEL_DIR = $env:CARR_CI_MODEL_DIR",
        "          $env:CARR_TEST_MODEL_MANIFEST = $env:CARR_CI_MODEL_MANIFEST",
        "          & $env:CARR_PYTHON -B -X utf8 scripts/ci_feature_capacity.py --mode source --head $sourceCommit --report-dir ci-results 2>&1 | Tee-Object 'ci-results/additional-source.txt'",
        "          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
        ""
      ]
    },
    {
