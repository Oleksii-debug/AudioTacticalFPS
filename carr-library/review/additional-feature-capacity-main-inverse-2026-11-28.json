    {
      "start": 2077,
      "removed": [],
      "added": [
        "      - name: Require added features and capacity in the exact complete bundle",
        "        id: additional_bundle",
        "        if: ${{ !cancelled() && steps.complete_bundle.outcome == 'success' }}",
        "        timeout-minutes: 30",
        "        shell: pwsh",
        "        run: |",
        "          $bundle = $env:CARR_CI_BUNDLE",
        "          if (!$bundle -or !(Test-Path -LiteralPath $bundle -PathType Container)) { throw 'The already verified complete bundle is required.' }",
        "          $python = Join-Path $bundle '.venv/Scripts/python.exe'",
        "          $sourceCommit = (git rev-parse HEAD).Trim()",
        "          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
        "          Remove-Item Env:PYTHONPATH, Env:PYTEST_ADDOPTS, Env:PYTEST_PLUGINS -ErrorAction SilentlyContinue",
        "          $env:PYTEST_DISABLE_PLUGIN_AUTOLOAD = '1'",
        "          $env:CARR_TEST_MODEL_DIR = Join-Path $bundle 'models/minilm'",
        "          $env:CARR_OCR_DIR = Join-Path $bundle 'ocr'",
        "          $manifestPath = Join-Path $bundle 'bundle-manifest.json'",
        "          $manifestBefore = (Get-FileHash -LiteralPath $manifestPath -Algorithm SHA256).Hash",
        "          $probeNames = @('windows_translation_v3_smoke.py', 'windows_backup_import_access_smoke.py')",
        "          $probeBefore = @{}",
        "          foreach ($name in $probeNames) { $probeBefore[$name] = (Get-FileHash -LiteralPath (Join-Path 'scripts' $name) -Algorithm SHA256).Hash }",
        "          $programs = @($python, (Join-Path $bundle '.venv/Scripts/pythonw.exe'),",
        "            (Join-Path $bundle 'runtime/python.exe'), (Join-Path $bundle 'runtime/pythonw.exe'),",
        "            (Join-Path $bundle 'ResearchLibrary.exe'), (Join-Path $bundle 'ocr/tesseract.exe'),",
        "            (Join-Path $bundle 'audio-runtime/bin/ffmpeg.exe'), (Join-Path $bundle 'audio-runtime/bin/ffprobe.exe'),",
        "            (Join-Path $bundle 'audio-runtime/bin/ffplay.exe'),",
        "            (Join-Path $env:SystemRoot 'System32/WindowsPowerShell/v1.0/powershell.exe'),",
        "            (Join-Path $env:SystemRoot 'SysWOW64/WindowsPowerShell/v1.0/powershell.exe')) |",
        "            ForEach-Object { if (!(Test-Path -LiteralPath $_ -PathType Leaf)) { throw 'A required installed runtime program is absent.' }; [System.IO.Path]::GetFullPath($_) } |",
        "            Select-Object -Unique",
        "          $remoteRanges = @('0.0.0.1-126.255.255.255', '128.0.0.0-255.255.255.255',",
        "            '::2-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff')",
        "          function Normalize-AdditionalRanges($Ranges) {",
        "            @($Ranges | ForEach-Object {",
        "              $ends = $_ -split '-', 2",
        "              if ($ends.Count -ne 2) { throw 'Unexpected firewall remote-address filter.' }",
        "              ([System.Net.IPAddress]::Parse($ends[0])).ToString() + '-' + ([System.Net.IPAddress]::Parse($ends[1])).ToString()",
        "            } | Sort-Object)",
        "          }",
        "          $expectedRanges = @(Normalize-AdditionalRanges $remoteRanges)",
        "          $rulePrefix = 'CARR-additional-' + [guid]::NewGuid().ToString('N')",
        "          $ruleNames = @()",
        "          $profilesBefore = @(Get-NetFirewallProfile -ErrorAction Stop | Select-Object Name, Enabled)",
        "          try {",
        "            Set-NetFirewallProfile -Profile Domain, Private, Public -Enabled True -ErrorAction Stop",
        "            foreach ($program in $programs) {",
        "              $ruleName = $rulePrefix + '-' + $ruleNames.Count",
        "              $ruleNames += $ruleName",
        "              New-NetFirewallRule -Name $ruleName -DisplayName $ruleName -Direction Outbound -Action Block -Profile Any -Program $program -RemoteAddress $remoteRanges -Enabled True -ErrorAction Stop | Out-Null",
        "            }",
        "            $profiles = @(Get-NetFirewallProfile -ErrorAction Stop)",
        "            if (@($profiles | Where-Object { $_.Enabled -ne 'True' }).Count -ne 0) { throw 'Added bundle checks require active firewall profiles.' }",
        "            $active = @(Get-NetFirewallRule -PolicyStore ActiveStore -Name $ruleNames -ErrorAction Stop)",
        "            if ($active.Count -ne $programs.Count -or @($active | Where-Object { $_.Enabled -ne 'True' -or $_.Direction -ne 'Outbound' -or $_.Action -ne 'Block' }).Count -ne 0) { throw 'Added bundle egress rules are not active.' }",
        "            $filters = @($active | Get-NetFirewallApplicationFilter -ErrorAction Stop | Select-Object -ExpandProperty Program | ForEach-Object { [System.IO.Path]::GetFullPath($_) })",
        "            if (@(Compare-Object ($programs | Sort-Object) ($filters | Sort-Object)).Count -ne 0) { throw 'Added bundle rules do not cover every selected runtime.' }",
        "            foreach ($rule in $active) {",
        "              $actualRanges = @(Normalize-AdditionalRanges @(($rule | Get-NetFirewallAddressFilter -ErrorAction Stop).RemoteAddress))",
        "              if (@(Compare-Object $expectedRanges $actualRanges).Count -ne 0) { throw 'Added bundle rule remote coverage differs.' }",
        "            }",
        "            @{ status='PASS'; blocked_programs=$filters; blocked_remote_ranges=$expectedRanges; allowed_test_peer='loopback'; scope='actual installed programs; synthetic local provider fixtures only' } |",
        "              ConvertTo-Json -Depth 4 | Set-Content 'ci-results/additional-bundle-firewall.json'",
        "            & $python -I -B -X utf8 scripts/ci_feature_capacity.py --mode installed --bundle $bundle --head $sourceCommit --report-dir ci-results 2>&1 | Tee-Object 'ci-results/additional-installed.txt'",
        "            if ($LASTEXITCODE -ne 0) { throw 'Added feature/capacity installed cases did not pass.' }",
        "            & $python -I -B -X utf8 scripts/windows_translation_v3_smoke.py --expect-installed --output ci-results/bundle-formatted-translation.json 2>&1 | Tee-Object 'ci-results/bundle-formatted-translation.txt'",
        "            if ($LASTEXITCODE -ne 0) { throw 'Actual bundled formatted translation controls did not pass.' }",
        "            & $python -I -B -X utf8 scripts/windows_backup_import_access_smoke.py 2>&1 | Tee-Object 'ci-results/bundle-native-backup-import.txt'",
        "            if ($LASTEXITCODE -ne 0) { throw 'Actual bundled import and backup controls did not pass.' }",
        "            foreach ($name in $probeNames) {",
        "              if ((Get-FileHash -LiteralPath (Join-Path 'scripts' $name) -Algorithm SHA256).Hash -ne $probeBefore[$name]) { throw 'A native acceptance probe changed during execution.' }",
        "            }",
        "            if ((Get-FileHash -LiteralPath $manifestPath -Algorithm SHA256).Hash -ne $manifestBefore) { throw 'The complete bundle seal changed during added acceptance.' }",
        "            & $python -I -B -X utf8 scripts/ci_feature_capacity.py --mode native --bundle $bundle --head $sourceCommit --report-dir ci-results 2>&1 | Tee-Object 'ci-results/additional-native.txt'",
        "            if ($LASTEXITCODE -ne 0) { throw 'Added native receipts or the complete bundle identity did not pass.' }",
        "          } finally {",
        "            foreach ($ruleName in $ruleNames) { Remove-NetFirewallRule -Name $ruleName -ErrorAction SilentlyContinue }",
        "            foreach ($profile in $profilesBefore) { Set-NetFirewallProfile -Profile $profile.Name -Enabled $profile.Enabled -ErrorAction Stop }",
        "          }",
        ""
      ]
    },
    {
      "start": 2204,
      "removed": [],
      "added": [
        "      - name: Require added features and capacity against the complete source runtime",
        "        id: additional_source",
