        {
          "start": 281,
          "removed": [],
          "added": [
            "      - name: Require actual native reader pause controls in both package modes",
            "        if: runner.os == 'Windows'",
            "        timeout-minutes: 5",
            "        shell: pwsh",
            "        run: |",
            "          $readerProof = @'",
            "          from hashlib import sha256",
            "          import json",
            "          import pathlib",
            "          import runpy",
            "          import subprocess",
            "          import sys",
            "          import sysconfig",
            "          import os",
            "          root = pathlib.Path.cwd().resolve()",
            "          head = os.environ['CARR_CUE_HEAD']",
            "          tracked = ('scripts/ci_feature_capacity.py', 'scripts/windows_voice_preferences_smoke.py',",
            "                     'scripts/windows_clipboard_reader_smoke.py')",
            "          before = {}",
            "          for relative in tracked:",
            "              raw = (root / relative).read_bytes()",
            "              committed = subprocess.run(['git', 'show', head + ':carr-library/' + relative],",
            "                  check=True, capture_output=True, timeout=20).stdout",
            "              assert raw == committed, relative",
            "              before[relative] = sha256(raw).hexdigest()",
            "          helper = runpy.run_path(str(root / 'scripts/ci_feature_capacity.py'))",
            "          source = root / 'src/carr_library'",
            "          installed = pathlib.Path(sysconfig.get_path('purelib')).resolve() / 'carr_library'",
            "          reference = json.loads((root / 'review/capacity-python-reference-2026-11-28.json').read_text(encoding='utf-8'))",
            "          expected = reference['compact_mapping']",
            "          assert helper['inventory'](source) == helper['inventory'](installed) == expected",
            "          record = helper['installed_record'](installed, expected)",
            "          results = []",
            "          errors = []",
            "          for mode, selected in (('source', source), ('installed', installed)):",
            "              path = root / 'ci-cue-interchange' / ('reading-pauses-' + mode + '.json')",
            "              command = [sys.executable, '-I', '-B', '-X', 'utf8',",
            "                         str(root / 'scripts/windows_voice_preferences_smoke.py')]",
            "              command += ['--source', str(root)] if mode == 'source' else ['--expect-installed']",
            "              completed = subprocess.run(command + ['--report', str(path)], timeout=105)",
            "              if completed.returncode:",
            "                  errors.append(mode + ': native process failed')",
            "                  continue",
            "              results.append(dict(mode=mode, **helper['reader_pause_receipt'](",
            "                  root, path, selected, expected, installed=mode == 'installed')))",
            "          assert helper['inventory'](source) == helper['inventory'](installed) == expected",
            "          assert helper['installed_record'](installed, expected) == record",
            "          helper['checkout_head'](root, head)",
            "          assert {name: sha256((root / name).read_bytes()).hexdigest() for name in tracked} == before",
            "          assert not errors and len(results) == 2, errors",
            "          output = dict(status='PASS', commit=head, package_python_files=len(expected),",
            "              RECORD_sha256=record, tracked_files=before, modes=results, NVDA='NOT_RUN',",
            "              acoustic_quality='NOT_RUN', physical_audio='NOT_RUN')",
            "          (root / 'ci-cue-interchange/reading-pauses-qualification.json').write_text(",
            "              json.dumps(output, sort_keys=True, indent=2) + '\\n', encoding='utf-8')",
            "          print(json.dumps(output, sort_keys=True), flush=True)",
            "          '@",
            "          python -I -B -X utf8 -c $readerProof 2>&1 | Tee-Object 'ci-cue-interchange/reading-pauses-qualification.txt'",
            "          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
            ""
          ]
