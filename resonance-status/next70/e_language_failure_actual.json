  "diagnosis": {
    "type": "FIXTURE_IMPORT_TYPE_FAILURE",
    "first_cause": "Both passive tests replaced subprocess.Popen with a function. The first real FileLock import reaches asyncio.windows_utils, whose Popen subclasses subprocess.Popen. Subclassing the replacement function raises TypeError before the intended state operation completes.",
    "later_cascade": "Later attempts in the same pytest child encounter the partially initialized asyncio module and NameError for base_events.",
    "product_change_supported": false,
    "offline_socket_policy_change_supported": false,
    "correction_plan": "Keep the real Popen class and temporarily replace only its __init__ with the same pytest.fail callback. This also avoids caching a temporary forbidden subclass as asyncio's permanent base.",
    "execution_status_of_correction": "NOT_RUN"
  },
  "primary_sources": [
    {
      "url": "https://github.com/python/cpython/blob/v3.11.9/Lib/subprocess.py",
      "sha256": "baa9f9138d8d20df6284f67e7d2e790f847f65e2c5370de322d54cccd737f2d9",
      "bytes": 88725,
      "observed": "The Popen class defines _child_created=False before __init__; __del__ returns immediately when that attribute is false. The sentinel raises before the original initializer creates a child."
    },
    {
      "url": "https://github.com/python/cpython/blob/v3.11.9/Lib/asyncio/windows_utils.py",
      "sha256": "e6fcffefa2521666bc2aed0f5caf8e862c1c1014ad12d2ab5fbce09c2df9c6f0",
      "bytes": 5060,
      "observed": "windows_utils.Popen subclasses subprocess.Popen and calls super().__init__; preserving the original base class avoids a poisoned cached subclass after monkeypatch undo."
    }
  ],
